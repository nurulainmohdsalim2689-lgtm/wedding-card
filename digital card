            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(123, 154, 116, 0.6);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .gallery-item:hover .gallery-overlay {
            opacity: 1;
        }

        .gallery-icon {
            color: var(--white);
            font-size: 2rem;
