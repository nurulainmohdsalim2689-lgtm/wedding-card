            width: 100%;
            object-fit: cover;
            transition: transform 0.6s ease;
        }

        .service-card:hover .service-img {
            transform: scale(1.05);
        }

        .service-content {
            padding: 2.5rem 2rem;
            text-align: center;
        }

        .service-content h3 {
            font-size: 1.5rem;
            margin-bottom: 1rem;
        }

        /* Gallery Section */
        .gallery {
            background-color: var(--secondary-color);
        }

        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
        }

        .gallery-item {
            position: relative;
            overflow: hidden;
            border-radius: 12px;
            aspect-ratio: 4/5;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }

        .gallery-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s ease;
        }

        .gallery-item:hover img {
            transform: scale(1.1);
        }

        .gallery-overlay {
