                position: absolute;
                top: 100%;
                left: -100%;
                width: 100%;
                background-color: var(--white);
                flex-direction: column;
                padding: 2rem 0;
                gap: 1.5rem;
                box-shadow: 0 5px 10px rgba(0,0,0,0.1);
                transition: 0.4s ease;
            }

            .nav-links.active {
                left: 0;
            }

            .nav-links .btn {
                margin-top: 1rem;
            }

            .section-title {
                font-size: 2rem;
            }
        }
    </style>
</head>
