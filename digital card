        }

        /* CTA Section (Garden Theme Background Image) */
        .cta-section {
            background: linear-gradient(rgba(45, 54, 44, 0.85), rgba(45, 54, 44, 0.85)), url('https://images.unsplash.com/photo-1519225421980-715cb0215aed?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80') center/cover fixed;
